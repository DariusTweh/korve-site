<section class="korve-section korve-categories">
  <div class="korve-shell">
    <header class="korve-categories__header" data-korve-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="korve-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="korve-section-title">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}<a class="korve-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
    </header>

    <div class="korve-categories__grid">
      {%- for block in section.blocks -%}
        {%- assign chosen_collection = block.settings.collection -%}
        {%- if chosen_collection != blank -%}
          {%- assign category_image = block.settings.image | default: chosen_collection.featured_image -%}
          <a class="korve-category" href="{{ chosen_collection.url }}" {{ block.shopify_attributes }} data-korve-reveal>
            <div class="korve-category__media">
              {%- if category_image != blank -%}
                {{ category_image | image_url: width: 1400 | image_tag: widths: '480, 760, 1000, 1400', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy' }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="korve-category__label">
              <span>{{ block.settings.label | default: chosen_collection.title | escape }}</span>
              <span aria-hidden="true">↗</span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .korve-categories { padding-block: var(--korve-section-space); }
  .korve-categories__header { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: clamp(2rem, 5vw, 4rem); }
  .korve-categories__header .korve-eyebrow { margin-bottom: 1rem; }
  .korve-categories__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(.6rem, 1.5vw, 1.5rem); }
  .korve-category { position: relative; min-height: clamp(28rem, 58vw, 50rem); overflow: hidden; color: #fff; text-decoration: none; }
  .korve-category:nth-child(3n) { grid-column: 1 / -1; min-height: clamp(24rem, 48vw, 44rem); }
  .korve-category__media, .korve-category__media img, .korve-category__media svg { width: 100%; height: 100%; }
  .korve-category__media img, .korve-category__media svg { object-fit: cover; transition: transform .8s var(--korve-ease); }
  .korve-category::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgb(0 0 0 / .45), transparent 45%); }
  .korve-category__label { position: absolute; z-index: 1; inset: auto 0 0; display: flex; justify-content: space-between; padding: clamp(1.2rem, 2.5vw, 2.2rem); font-size: clamp(1.45rem, 3vw, 3rem); font-weight: 600; letter-spacing: -.04em; }
  .korve-category:hover .korve-category__media img { transform: scale(1.025); }
  @media screen and (max-width: 749px) {
    .korve-categories__header { align-items: start; flex-direction: column; }
    .korve-categories__grid { grid-template-columns: 1fr; }
    .korve-category, .korve-category:nth-child(3n) { grid-column: auto; min-height: 70svh; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KORVE category grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SHOP BY CATEGORY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FIND YOUR UNIFORM." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "VIEW ALL" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    { "type": "category", "name": "Category", "limit": 4, "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "image_picker", "id": "image", "label": "Custom image" },
      { "type": "text", "id": "label", "label": "Custom label" }
    ] }
  ],
  "presets": [{ "name": "KORVE category grid", "blocks": [{"type":"category"},{"type":"category"},{"type":"category"}] }]
}
{% endschema %}
