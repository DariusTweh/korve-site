{%- liquid
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: desktop_image
-%}

<section class="korve-hero" style="--hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --hero-position: {{ section.settings.content_position }};">
  <div class="korve-hero__media">
    {%- if desktop_image != blank -%}
      <picture>
        {%- if mobile_image != blank -%}
          <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 1200 }}">
        {%- endif -%}
        {{ desktop_image | image_url: width: 2400 | image_tag: widths: '960, 1440, 1920, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'korve-hero__image' }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'korve-hero__placeholder' }}
    {%- endif -%}
  </div>
  <div class="korve-hero__shade" aria-hidden="true"></div>
  <div class="korve-hero__content"{% if section.settings.animate %} data-korve-reveal{% endif %}>
    {%- if section.settings.eyebrow != blank -%}<p class="korve-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h1>{{ section.settings.heading | escape }}</h1>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="korve-hero__text">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a class="korve-hero__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .korve-hero { min-height: min(920px, calc(100svh - 2rem)); position: relative; display: grid; overflow: hidden; color: #fff; background: #111; }
  .korve-hero__media, .korve-hero__shade, .korve-hero__content { grid-area: 1 / 1; }
  .korve-hero__media, .korve-hero__media picture { width: 100%; height: 100%; }
  .korve-hero__image, .korve-hero__placeholder { width: 100%; height: 100%; object-fit: cover; }
  .korve-hero__shade { z-index: 1; background: linear-gradient(90deg, rgb(0 0 0 / calc(var(--hero-overlay) + .14)), rgb(0 0 0 / calc(var(--hero-overlay) * .45))); }
  .korve-hero__content { z-index: 2; align-self: end; justify-self: var(--hero-position); width: min(100%, 1600px); padding: clamp(7rem, 16vh, 11rem) var(--korve-page-gutter) clamp(3rem, 7vw, 6rem); }
  .korve-hero__content h1 { max-width: 9ch; margin: .4rem 0 1.4rem; color: inherit; font-size: var(--korve-display); font-weight: 650; letter-spacing: -.065em; line-height: .84; text-wrap: balance; }
  .korve-hero__text { max-width: 34rem; font-size: clamp(1rem, 1.5vw, 1.25rem); line-height: 1.45; }
  .korve-hero__text p { margin: 0; }
  .korve-hero__button { display: inline-flex; margin-top: 2rem; min-height: 3.25rem; padding: .9rem 1.5rem; align-items: center; background: var(--korve-yellow); color: var(--korve-black); font-size: .75rem; font-weight: 700; letter-spacing: .14em; text-decoration: none; text-transform: uppercase; transition: background .25s ease, color .25s ease; }
  .korve-hero__button:hover { background: #fff; }
  @media screen and (max-width: 749px) {
    .korve-hero { min-height: 76svh; }
    .korve-hero__shade { background: linear-gradient(0deg, rgb(0 0 0 / .58), rgb(0 0 0 / .05) 65%); }
    .korve-hero__content { padding-bottom: 2rem; }
    .korve-hero__content h1 { max-width: 8ch; font-size: clamp(3.5rem, 17vw, 5.5rem); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KORVE editorial hero",
  "tag": "section",
  "class": "korve-hero-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "KORVE / NEW SEASON" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "NOT MADE TO BLEND IN." },
    { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Original pieces. Effortless confidence. Everyday expression.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP KORVE" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "content_position", "label": "Content alignment", "options": [{"value":"start","label":"Left"},{"value":"center","label":"Center"}], "default": "start" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 25 },
    { "type": "checkbox", "id": "animate", "label": "Animate content on reveal", "default": true }
  ],
  "presets": [{ "name": "KORVE editorial hero" }]
}
{% endschema %}
